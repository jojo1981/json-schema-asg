{
  "name": "jojo1981/json-schema-asg",
  "description": "Json schema abstract semantic graph builder",
  "keywords": [
    "json",
    "schema",
    "abstract",
    "semantic",
    "graph",
    "ast",
    "parser",
    "resolver",
    "builder",
    "generator"
  ],
  "type": "library",
  "license": "MIT",
  "readme": "README.md",
  "authors": [
    {
      "name": "Joost Nijhuis",
      "email": "jnijhuis81@gmail.com"
    }
  ],
  "prefer-stable": true,
  "minimum-stability": "stable",
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "league/uri-components": "^7.5",
    "league/uri": "^7.5",
    "symfony/yaml": "^4.0|^5.0|^6.0|^7.0|^8.0"
  },
  "autoload": {
    "psr-4": {
      "Jojo1981\\JsonSchemaAsg\\": "src/"
    }
  },
  "require-dev": {
    "dg/bypass-finals": "^1.0",
    "phpspec/prophecy-phpunit": "^2.0",
    "phpunit/phpunit": "^10.0|^11.0|^12.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Jojo1981\\JsonSchemaAsg\\": "tests/"
    }
  },
  "config": {
    "bin-dir": "bin",
    "sort-packages": true
  },
  "scripts": {
    "test": [
      "./bin/phpunit"
    ]
  }
}
